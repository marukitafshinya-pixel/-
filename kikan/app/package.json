{
  "name": "kikan-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "create-user": "tsx server/scripts/create-user.ts",
    "typecheck": "tsc --noEmit -p .",
    "build:demo": "vite build -c vite.demo.config.ts && python3 client/src/demo/to_artifact.py dist-demo && rm -f dist-demo/assets/pglite-*.data"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^8.3.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
